{
  "expo": {
    "name": "Jamia Islamia",
    "slug": "jamia-islamia-school",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090d16"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.jamiaislamia.bhatkal"
    },
    "android": {
      "package": "edu.jamiaislamia.bhatkal",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#064e3b"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "NOTIFICATIONS",
        "VIBRATE",
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10b981",
          "sounds": []
        }
      ]
    ]
  }
}
