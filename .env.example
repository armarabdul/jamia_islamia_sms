# Core Django Configuration
DJANGO_SECRET_KEY=change-me-to-a-secure-random-64-char-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,web,testserver
ENVIRONMENT=development

# Database Configuration (PostgreSQL 16)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=jamia_islamia_db
DB_USER=jamia_admin
DB_PASSWORD=jamia_secure_password_2026
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Redis & Celery Cache / Broker
REDIS_URL=redis://redis:6379/1

# Security & Proxy Settings (Production)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=31536000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# JWT Token Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=120
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Logging & Monitoring
DJANGO_LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Production Gunicorn Parameters
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Domain & Application URL
DOMAIN_NAME=jamiaislamia.edu.in
API_BASE_URL=http://localhost:8000/api/v1
